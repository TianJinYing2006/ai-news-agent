# ===== LLM（DeepSeek）=====
# 必填。见 docs/tech-stack-selection.md §3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== 搜索（Tavily，1000 credits/月免费）=====
TAVILY_API_KEY=

# ===== 邮件（SMTP，见 docs §8.1）=====
# 注意：Agent Mail 不可用（需逐次人工确认），改用脚本自带 SMTP
# QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP → 生成授权码（不是登录密码）
# 收件人不在 .env 里配置 —— 取网页「身份」页填写的邮箱（profile.email），
# 避免在环境变量和网页两处各维护一份导致不一致。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=每日 AI 简报

# ===== 代理（按需；本机实测端口 58928，不是 7897）=====
# HTTPS_PROXY=http://127.0.0.1:58928
# HTTP_PROXY=http://127.0.0.1:58928

# ===== 可观测（可选，见 docs §1）=====
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://jp.cloud.langfuse.com

# ===== 循环硬闸（见 docs §5.3）=====
MAX_STEPS=30
TOKEN_BUDGET=800000
LOOP_WINDOW=3
