# 可选的 .env 兜底（已 gitignore）。推荐用 Windows 用户级环境变量（setx / 系统设置）；
# 系统环境变量优先级高于本文件（dotenv 不覆盖已存在的变量）。详见 README「快速开始」。

# ===== LLM（DeepSeek）=====
# 必填。见 docs/tech-stack-selection.md §3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== 搜索（Tavily，1000 credits/月免费）=====
TAVILY_API_KEY=

# ===== 邮件（SMTP，见 docs §8.1）=====
# 注意：Agent Mail 不可用（需逐次人工确认），改用脚本自带 SMTP
# QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP → 生成授权码（不是登录密码）
# 收件人不在 .env 里配置 —— 取网页「身份」页填写的邮箱（profile.email），
# 避免在环境变量和网页两处各维护一份导致不一致。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=每日 AI 简报

# ===== 邮件重试（docs §3.5：重试次数和间隔配置化）=====
SMTP_RETRIES=2
SMTP_RETRY_DELAY=5

# ===== 代理（按需；本机实测端口 58928，不是 7897）=====
# HTTPS_PROXY=http://127.0.0.1:58928
# HTTP_PROXY=http://127.0.0.1:58928

# ===== 可观测（可选，见 docs §1）=====
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://jp.cloud.langfuse.com

# ===== 循环硬闸（见 docs §5.3）=====
MAX_STEPS=30
# 预算是"成本护栏"：实测同任务波动 35 万–88 万 tokens，1.2M 留有约 40% 余量；
# 触发即失败并记录，绝不发降级简报。
TOKEN_BUDGET=1200000
LOOP_WINDOW=3

# ===== 进程内调度（APScheduler，随 web 服务启动）=====
# 推送时间默认值（Asia/Shanghai，HH:MM）。可在网页「历史简报」页修改（存 SQLite，优先于本项、即时生效）。
# 服务启动时会补跑当天错过的运行；更早日期不补发（详见 README「每日运行与调度」）。
DAILY_RUN_AT=07:00
